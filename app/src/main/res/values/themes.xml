        <item name="android:windowBackground">#080603</item>
        <item name="android:colorBackground">#080603</item>
        <item name="android:textColor">#FFFDF4</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
